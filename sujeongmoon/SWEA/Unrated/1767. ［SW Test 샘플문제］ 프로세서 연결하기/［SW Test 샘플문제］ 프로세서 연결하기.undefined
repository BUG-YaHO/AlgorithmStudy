import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.List;
import java.util.StringTokenizer;

public class Solution {
	
	static int N; // 배열 크기
	static int P; // 프로세서 개수
	
	static int[][] arr; // 프로세서 배열
	static boolean[][] isVisited; // 프로세서 방문 배열
	static List<int[]> list; // 프로세서 좌표 저장 배열
	
	static int[] dr = {1, 0, -1, 0};
	static int[] dc = {0, 1, 0, -1};
	
	static int answer; // 최소 전선 개수
	static int answerP; // 최소 전선 개수 비교 시 프로세서 개수

	public static void main(String[] args) throws Exception{

		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuilder sb = new StringBuilder();
		
		int T = Integer.parseInt(br.readLine());
		
		for (int t = 1; t <= T; t++) {
			
			N = Integer.parseInt(br.readLine());
			list = new ArrayList<>();
			arr = new int[N][N];
			isVisited = new boolean[N][N];
			
			for (int i = 0; i < N; i++) {
				StringTokenizer st = new StringTokenizer(br.readLine());
				for (int j = 0; j < N; j++) {
					arr[i][j] = Integer.parseInt(st.nextToken());
					if (arr[i][j] == 1) {
						list.add(new int[] {i, j});
						isVisited[i][j] = true; // 프로세서 위치는 미리 방문처리
					}
				}
			}
			
			answer = Integer.MAX_VALUE;
			answerP = 0;
			P = list.size();
			
			find(0, 0, 0);
			
			sb.append("#").append(t).append(" ").append(answer).append("\n");
		}
		System.out.print(sb);
	}
	
	// 배열 count번쨰 인덱스 프로세서에 대한 전원 연결 함수
	static void find(int nowP, int count, int sum) {
		
		if (count == P) { // 프로세서 최대인 경우만 갱신
			if (nowP > answerP) {
				// 코어가 더 많이 연결된 경우 무조건 갱신
				answerP = nowP;
				answer = sum;
			} else if (nowP == answerP && sum < answer) {
				// 코어 수는 같은데 sum이 더 작은 경우 갱신
				answer = sum;
			}
			return;
		}
		
		// 맞닿아 있는 경우는 그냥 패스
		int nowR = list.get(count)[0];
		int nowC = list.get(count)[1];
		
		if (nowR == 0 || nowC == 0 || nowR == N-1 || nowC == N-1) {
			// 맞닿아있는 경우 무조건 바로 넘기기
			find(nowP+1, count+1, sum);
			return;
		}
		
		
		for (int i = 0; i < 4; i++) {
			int nextR = nowR+dr[i];
			int nextC = nowC+dc[i];
			boolean isPossible = true; // 전선 연결 가능 불가능 체크
			int nowSum = 0; // 전선을 연결한다면 그 길이의 합
			while(true) {
				// 전선을 연결할 수 있는 경우
				if (nextR < 0 || nextR == N || nextC < 0 || nextC == N) {
					break;
				}
				// 전선 연결이 불가능한 경우
				if (isVisited[nextR][nextC]) {
					isPossible = false;
					break;
				}
				// nowSum++; // 가능할 때마다 nowSum을 더해줌
				nextR += dr[i];
				nextC += dc[i];
				
			}
			if (!isPossible) {
				continue;
			}
			
			nextR = list.get(count)[0]+dr[i];
			nextC = list.get(count)[1]+dc[i];
			
			while(true) {
				if (nextR < 0 || nextR == N || nextC < 0 || nextC == N) {
					break;
				}
				// 방문 가능하단 거 확인했으니 방문처리
				isVisited[nextR][nextC] = true;
				nowSum++;
				nextR += dr[i];
				nextC += dc[i];
			}
			
			find(nowP+1, count+1, sum+nowSum);
			
			// 방문한 내용 다 지우기
			nextR = list.get(count)[0]+dr[i];
			nextC = list.get(count)[1]+dc[i];
			
			while(true) {
				if (nextR < 0 || nextR == N || nextC < 0 || nextC == N) {
					break;
				}
				// 방문 가능하단 거 확인했으니 방문처리
				isVisited[nextR][nextC] = false;
				nextR += dr[i];
				nextC += dc[i];
			}
		}
		
		// 방문 못하는 경우 진행
		find(nowP, count+1, sum);
		
		
	}

}
